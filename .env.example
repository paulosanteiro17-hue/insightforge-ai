# Copy this file to .env for Docker Compose and to the application-specific
# environment files described in README.md. Never commit real credentials.

# Shared URLs
POSTGRES_DB=insightforge
POSTGRES_USER=insightforge
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+asyncpg://insightforge:local-development-only@postgres:5432/insightforge
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=/api/v1
WEB_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1

# API runtime
INSIGHTFORGE_ENVIRONMENT=development
INSIGHTFORGE_LOG_LEVEL=INFO
INSIGHTFORGE_ALLOWED_ORIGINS=["http://localhost:3000"]
INSIGHTFORGE_ALLOWED_HOSTS=["localhost","127.0.0.1","api"]
INSIGHTFORGE_SESSION_COOKIE_SECURE=false
INSIGHTFORGE_SESSION_IDLE_MINUTES=30
INSIGHTFORGE_SESSION_ABSOLUTE_HOURS=168
INSIGHTFORGE_CSRF_SIGNING_KEY=replace-with-at-least-32-random-characters
INSIGHTFORGE_CSRF_ALLOWED_ORIGINS=["http://localhost:3000"]
INSIGHTFORGE_AUTH_GLOBAL_LIMIT=120
INSIGHTFORGE_AUTH_GLOBAL_WINDOW_SECONDS=60
INSIGHTFORGE_LOGIN_ACCOUNT_LIMIT=10
INSIGHTFORGE_LOGIN_ACCOUNT_WINDOW_SECONDS=300
INSIGHTFORGE_REGISTER_BROWSER_LIMIT=5
INSIGHTFORGE_REGISTER_BROWSER_WINDOW_SECONDS=3600
INSIGHTFORGE_DEMO_BROWSER_LIMIT=3
INSIGHTFORGE_DEMO_BROWSER_WINDOW_SECONDS=3600
INSIGHTFORGE_DEMO_GLOBAL_LIMIT=30
INSIGHTFORGE_DEMO_GLOBAL_WINDOW_SECONDS=60
INSIGHTFORGE_PASSWORD_RESET_LIMIT=5
INSIGHTFORGE_PASSWORD_RESET_WINDOW_SECONDS=3600
INSIGHTFORGE_PASSWORD_RESET_EXPIRY_MINUTES=30
INSIGHTFORGE_PRIVATE_STORAGE_PATH=/app/.data/private
INSIGHTFORGE_UPLOAD_MAX_BYTES=10485760
INSIGHTFORGE_REQUEST_MAX_BYTES=12582912
INSIGHTFORGE_UPLOAD_MAX_ROWS=50000
INSIGHTFORGE_IMPORT_MAX_ERRORS=100
INSIGHTFORGE_IMPORT_PREVIEW_ROWS=20
INSIGHTFORGE_IMPORT_RETENTION_HOURS=168
INSIGHTFORGE_DEMO_MODE=true

# Optional OpenAI adapter. Leave the key empty to use deterministic insights.
INSIGHTFORGE_AI_PROVIDER=deterministic
INSIGHTFORGE_OPENAI_API_KEY=
INSIGHTFORGE_OPENAI_MODEL=gpt-5.6-sol
INSIGHTFORGE_OPENAI_TIMEOUT_SECONDS=20

# Web server-side proxy target
API_INTERNAL_URL=http://api:8000
